# Kept off pre-commit deliberately: these run on the whole graph, not staged
# files, so they are too slow to sit between "git commit" and a prompt. Pushing
# is the right gate — it is the last point before anyone else sees the code.
#
# Sequential, not parallel. Both tasks start with `intlayer build`, and two
# concurrent runs write the same generated dictionaries — that race failed the
# native suite at push time even when it passed standalone. Run in order and
# Vite Task's content-addressed cache makes the second `intlayer build` a hit on
# the first rather than a competing writer.
#
# The dispatcher runs this under `sh -e`, so the first failure stops the push.
vp run -r --cache check-types
vp run -r --cache test

# The vendored oxlint plugin is outside every workspace, so `vp run -r test`
# never sees it. Its rule tests are the only thing standing behind a local edit
# to tools/oxlint/anti-slop, and they take ~0.2s.
vp run --cache test:lint-plugins
