{
	"name": "outlayr",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "biome check --write .",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"dev:server": "turbo run dev -F @outlayr/backend",
		"dev:setup": "turbo run dev:setup -F @outlayr/backend",
		"prepare": "lefthook install",
		"test": "turbo run test"
	},
	"dependencies": {
		"@outlayr/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@outlayr/config": "workspace:*",
		"@types/node": "^26.1.1",
		"lefthook": "^2.1.10",
		"turbo": "^2.10.5",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@11.15.1"
}
