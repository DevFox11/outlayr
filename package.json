{
    "name": "outlayr",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "vp run -r --cache build",
        "check": "vp check",
        "check-types": "vp run -r --cache check-types",
        "dev": "vp run -r --parallel dev",
        "dev:server": "vp run --filter @outlayr/backend dev",
        "dev:setup": "vp run --filter @outlayr/backend dev:setup",
        "fix": "vp check --fix",
        "prepare": "vp config --no-agent --no-editor",
        "test": "vp run -r --cache test",
        "test:lint-plugins": "node --test \"tools/oxlint/anti-slop/rules/*.test.ts\""
    },
    "dependencies": {
        "@outlayr/env": "workspace:*",
        "dotenv": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@outlayr/config": "workspace:*",
        "@oxlint/plugins": "1.78.0",
        "@types/node": "^26.1.2",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "oxlint-tailwindcss": "^1.9.0",
        "typescript": "catalog:",
        "ultracite": "7.10.2",
        "vite-plus": "^0.2.9"
    },
    "packageManager": "pnpm@11.20.0"
}
