{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "allowJs": true,
        "types": ["node", "jest"],
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./assets/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "uniwind-env.d.ts",
        ".intlayer/types/**/*.ts"
    ],
    "exclude": ["node_modules", "ios", "android", "babel.config.js", "jest.config.js", "expo-env.d.ts"]
}
