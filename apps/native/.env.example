# Where the exchange-rate backend lives. Copy this file to `.env` and paste the
# deployment URL from `packages/backend/.env.local` (CONVEX_URL), or run
# `npx convex dev` in packages/backend to create one.
#
# OPTIONAL. The app is local-first: without this it still runs, and only
# currency conversion is unavailable. See packages/env/src/native.ts.
EXPO_PUBLIC_CONVEX_URL=https://example.convex.cloud

# The same deployment's HTTP origin — the `.site` host, not the `.cloud` one.
# Better Auth is served by packages/backend/convex/http.ts, which only exists
# there.
#
# OPTIONAL. Without it the app offers no account and the Settings Account row
# reads "Unavailable". Everything else is unaffected.
EXPO_PUBLIC_CONVEX_SITE_URL=https://example.convex.site

# Google OAuth client ids. These are read at BUILD time by the app, so setting
# them on the Convex deployment is not enough — the backend's own
# GOOGLE_CLIENT_ID_* are separate variables that happen to hold the same values.
# The iOS one is also reversed into a URL scheme by app.config.ts, so changing it
# needs a rebuild rather than a reload.
#
# OPTIONAL. Without the web id the Google button is not offered; Sign in with
# Apple is unaffected.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# RevenueCat public SDK keys. `test_…` for the simulator; the `appl_…` key lives in EAS.
# OPTIONAL. Without one the SDK never configures: nothing is Pro, every free limit applies.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog project token (`phc_…`, Project settings › Project API key). The
# project lives on US cloud, the SDK's default host.
# OPTIONAL. Without it no client is created and nothing is sent.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
