# Where the exchange-rate backend lives. Copy this file to `.env` and paste the
# deployment URL from `packages/backend/.env.local` (CONVEX_URL), or run
# `npx convex dev` in packages/backend to create one.
#
# OPTIONAL. The app is local-first: without this it still runs, and only
# currency conversion is unavailable. See packages/env/src/native.ts.
EXPO_PUBLIC_CONVEX_URL=https://example.convex.cloud
