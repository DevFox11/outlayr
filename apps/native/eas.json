{
    "cli": {
        "version": ">= 20.1.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "environment": "development",
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": true
            }
        },
        "development-device": {
            "extends": "development",
            "ios": {
                "simulator": false
            },
            "autoIncrement": true
        },
        "preview": {
            "environment": "preview",
            "distribution": "store",
            "autoIncrement": true
        },
        "production": {
            "environment": "production",
            "autoIncrement": true
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleTeamId": "8ZB3YXDU7V",
                "ascAppId": "6801652978"
            }
        }
    }
}
