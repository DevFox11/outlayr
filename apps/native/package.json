		"@outlayr/money": "workspace:*",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@shopify/react-native-skia": "2.6.2",
		"@tanstack/react-form": "1.33.3",
		"better-auth": "catalog:",
		"convex": "^1.42.2",
		"drizzle-orm": "catalog:",
		"expo": "~57.0.9",
		"expo-alternate-app-icons": "^8.0.0",
