    },
    "%@ • %@ spent": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "%@ • %@ gastado"
          }
        }
      }
    },
    "%@%.2f": {
      "comment": "A label displaying the total amount spent on a budget category. The argument is the total spent amount, formatted to two decimal places.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$.2f"
          }
        }
      }
    },
    "%@%@ was spent %@": {
      "comment": "A description of the amount of money spent on the day. The argument is the string “%.2f”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@ was spent %3$@"
          }
