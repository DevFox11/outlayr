{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\"Cent-less\" - If your transactions usually amount to whole numbers, this one is for you.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "“Sin centavos” - Si tus transacciones generalmente son números enteros, esta opción es para ti."
          }
        }
      }
    },
    "\"Pre-dotted\" - If you're too lazy to add a decimal point, I gotchu covered.": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "\"Pre-dotted\" - Si eres demasiado flojo para agregar un punto decimal, yo te cubro."
          }
        }
      }
    },
    "%.0f%%": {},
    "%.2f": {
      "comment": "A currency amount, formatted to two decimal places.",
      "isCommentAutoGenerated": true
    },
    "%@": {
      "comment": "The display representation of a budget.",
      "isCommentAutoGenerated": true
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (%@)": {
      "comment": "A chevron-down button that shows the user's selected currency and its symbol. The first argument is the currency code. The second argument is the currency symbol.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ SPENT": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "%@ GASTADO"
          }
        }
      }
    },
    "%@ of month": {
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "día %@ del mes"
          }
        }
      }
    },
    "%@ tab": {
      "comment": "The accessibility label for the tab button. The argument is the name of the tab.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es-419": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "pestaña %@"
          }
        }
      }
    },
