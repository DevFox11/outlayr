        "es-419": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "%1$@%2$@ gastado %3$@"
          }
        }
      }
    },
    "%@%lld": {
      "comment": "A label displaying the amount of a transaction. The first argument is the currency symbol. The second argument is the amount of the transaction.",
