# EAS Build upload filter.
#
# This file REPLACES .gitignore for the build upload — the EAS CLI prioritises it
# and stops consulting .gitignore entirely. Everything the four .gitignore files
# exclude is therefore restated here, or it would start being uploaded. Adding a
# line without reading docs/eas-upload.md is how apps/native/ios (1.2 GB of
# prebuild output) ends up in the tarball.

# ── Restated from .gitignore ──────────────────────────────────────────────────

node_modules
.pnp
.pnp.js

dist
build
*.tsbuildinfo

apps/web/src/routeTree.gen.ts

.env
.env*.local
packages/backend/.env.local

.vscode/*
.idea
*.swp
*.swo
*~
.DS_Store

logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

.turbo
.nx
.alchemy
.vercel

coverage
.nyc_output
.argent

*.tgz
.cache
tmp
temp
.atl

# apps/native — the paths here are anchored at the repo root, where
# apps/native/.gitignore anchored them at apps/native.
apps/native/.expo/
apps/native/ios
apps/native/android
apps/native/web-build/
apps/native/.metro-health-check*
apps/native/expo-env.d.ts
apps/native/assets/fonts/*.otf
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Regenerated by Metro from withUniwindConfig({ dtsFile }); shipping a stale copy
# is worse than shipping none.
apps/native/uniwind-types.d.ts

# apps/ios is excluded wholesale below, which subsumes its own .gitignore.

# ── Excluded beyond .gitignore ────────────────────────────────────────────────

# The SwiftUI app. A workspace member with no JS, so the Expo build never reads
# it — metro.config.cjs already drops it from the crawl for the same reason.
#
# The trailing `/*` is load-bearing. Excluding the directory itself (`apps/ios`)
# would make the negation below dead: git never descends into an excluded
# directory, so a file inside it cannot be re-included. Excluding the *contents*
# leaves the directory walkable and the negation effective.
#
# package.json survives because pnpm resolves `apps/*` from pnpm-workspace.yaml,
# and a member whose manifest is missing breaks `--frozen-lockfile`.
apps/ios/*
!apps/ios/package.json

# Prose. Nothing imports it.
docs/
apps/native/docs/
**/*.md

# Repo tooling that does not run on the builder.
.github/
.claude/
.vscode/
lefthook.yml
