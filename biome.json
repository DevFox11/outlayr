{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/.expo",
      "!**/.nx",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/src-tauri",
      "!bts.jsonc",
      "!skills-lock.json",
      "!**/.alchemy",
      "!**/wrangler.jsonc",
      "!**/.source",
      "!**/drizzle",
      "!**/uniwind-types.d.ts",
      "!**/ios",
      "!**/android",
      "!**/Pods",
      "!**/*.icon",
      "!**/*.svg",
      "!**/.agents",
      "!**/.claude",
      "!**/*.html"
    ]
  },
  "formatter": {
    "indentStyle": "tab",
    "lineWidth": 120
  },
  "javascript": {
    "globals": ["__DEV__", "jest"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      },
      "correctness": {
        "useExhaustiveDependencies": "info"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "preset": "recommended",
      "style": {
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noEqualsToNull": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.{ts,tsx}", "apps/native/jest/**"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "noBitwiseOperators": "off",
            "noEmptyBlockStatements": "off",
            "noUnnecessaryConditions": "off",
            "useAwait": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/native/src/domain/uuid5.ts",
        "apps/native/src/domain/confetti.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      "includes": ["**/global.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateCustomProperties": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/native/src/**",
        "!apps/native/src/data/live-query.ts",
        "!apps/native/src/lib/use-haptics.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "drizzle-orm/expo-sqlite": {
                    "importNames": ["useLiveQuery"],
                    "message": "Drizzle's useLiveQuery renders one empty frame before its query answers. Import useLiveQuery from @/data/live-query, which reads in render."
                  },
                  "expo-haptics": "A direct call fires whatever the Haptics setting says. Use useHaptics from @/lib/use-haptics."
                }
              }
            }
          }
        }
      }
    }
  ],
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vitest",
    "ultracite/biome/react",
    "ultracite/biome/jest",
    "ultracite/biome/tanstack",
    "ultracite/biome/astro"
  ]
}
